{"version": 2, "width": 80, "height": 24, "timestamp": 1778052390, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.172708, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[1mTsukuyomi — Illusion Layer Demo\u001b[0m\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[2mThe agent acts. You decide when it's real.\u001b[0m\r\n"]
[0.523431, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 1 — Agent sends an email\u001b[0m\r\n"]
[0.674393, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.774608, "o", "\u001b[2mThe agent wants to send a confirmation email to the client.\u001b[0m\r\n"]
[0.924769, "o", "\u001b[2mTsukuyomi intercepts it.\u001b[0m\r\n"]
[1.075074, "o", "\r\n"]
[1.175742, "o", "\u001b[36magent  →  \"send email to client@acmecorp.com — order confirmed\"\u001b[0m\r\n"]
[1.479876, "o", "\u001b[33magent  ←  (Tsukuyomi hands back)\u001b[0m\r\n"]
[1.63032, "o", "\u001b[36m    {\u001b[0m\r\n"]
[1.780403, "o", "\u001b[36m      \"status\": \"sent\",\u001b[0m\r\n"]
[1.930861, "o", "\u001b[36m      \"message_id\": \"msg-e0416ca06ae6@acmecorp.com\",\u001b[0m\r\n"]
[2.080893, "o", "\u001b[36m      \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[2.231723, "o", "\u001b[36m      \"subject\": \"Your order is confirmed \\u2014 #4821\",\u001b[0m\r\n"]
[2.381889, "o", "\u001b[36m      \"timestamp\": \"2026-05-06T07:26:31.507438+00:00\"\u001b[0m\r\n"]
[2.532063, "o", "\u001b[36m    }\u001b[0m\r\n"]
[2.732738, "o", "\r\n\u001b[2mThe agent believes the email was sent. It moves on.\u001b[0m\r\n"]
[2.882818, "o", "\r\n"]
[2.983467, "o", "\u001b[32myou    ←  audit record (internal — never reaches the agent):\u001b[0m\r\n"]
[3.133704, "o", "\u001b[2m    {\u001b[0m\r\n"]
[3.284458, "o", "\u001b[2m      \"simulated\": true,\u001b[0m\r\n"]
[3.434707, "o", "\u001b[2m      \"real_action_taken\": false,\u001b[0m\r\n"]
[3.585001, "o", "\u001b[2m      \"awaiting_approval\": true,\u001b[0m\r\n"]
[3.735096, "o", "\u001b[2m      \"adapter\": \"fake_email\",\u001b[0m\r\n"]
[3.885155, "o", "\u001b[2m      \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[4.035799, "o", "\u001b[2m      \"subject\": \"Your order is confirmed \\u2014 #4821\"\u001b[0m\r\n"]
[4.186261, "o", "\u001b[2m    }\u001b[0m\r\n"]
[4.386895, "o", "\u001b[2mNothing was sent. The action is staged. You approve it when ready.\u001b[0m\r\n"]
[4.536888, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 2 — Agent writes a file\u001b[0m\r\n"]
[4.687575, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[4.787687, "o", "\u001b[2mThe agent wants to update a report file.\u001b[0m\r\n"]
[4.938217, "o", "\r\n"]
[5.038904, "o", "\u001b[36magent  →  \"write file /reports/q2_summary.csv\"\u001b[0m\r\n"]
[5.340091, "o", "\u001b[33magent  ←  (Tsukuyomi hands back)\u001b[0m\r\n"]
[5.490342, "o", "\u001b[36m    {\u001b[0m\r\n"]
[5.6404, "o", "\u001b[36m      \"status\": \"written\",\u001b[0m\r\n"]
[5.790724, "o", "\u001b[36m      \"path\": \"/reports/q2_summary.csv\",\u001b[0m\r\n"]
[5.941375, "o", "\u001b[36m      \"bytes\": 41\u001b[0m\r\n"]
[6.09207, "o", "\u001b[36m    }\u001b[0m\r\n"]
[6.292956, "o", "\r\n\u001b[32myou    ←  audit record:\u001b[0m\r\n"]
[6.443336, "o", "\u001b[2m    {\u001b[0m\r\n"]
[6.593485, "o", "\u001b[2m      \"simulated\": true,\u001b[0m\r\n"]
[6.743678, "o", "\u001b[2m      \"real_action_taken\": false,\u001b[0m\r\n"]
[6.894323, "o", "\u001b[2m      \"awaiting_approval\": true,\u001b[0m\r\n"]
[7.044242, "o", "\u001b[2m      \"adapter\": \"fake_file\",\u001b[0m\r\n"]
[7.194962, "o", "\u001b[2m      \"path\": \"/reports/q2_summary.csv\"\u001b[0m\r\n"]
[7.345461, "o", "\u001b[2m    }\u001b[0m\r\n"]
[7.545759, "o", "\u001b[2mFile was not written. Staged.\u001b[0m\r\n"]
[7.696042, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 3 — Agent books a meeting\u001b[0m\r\n"]
[7.846314, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[7.947118, "o", "\u001b[2mThe agent wants to schedule a follow-up call.\u001b[0m\r\n"]
[8.097706, "o", "\r\n"]
[8.198309, "o", "\u001b[36magent  →  \"create calendar event — follow-up call 2024-07-15 14:00\"\u001b[0m\r\n"]
[8.499726, "o", "\u001b[33magent  ←  (Tsukuyomi hands back)\u001b[0m\r\n"]
[8.650029, "o", "\u001b[36m    {\u001b[0m\r\n"]
[8.800242, "o", "\u001b[36m      \"status\": \"created\",\u001b[0m\r\n"]
[8.95124, "o", "\u001b[36m      \"event_id\": \"evt-1c2676e09c83\",\u001b[0m\r\n"]
[9.101482, "o", "\u001b[36m      \"title\": \"Follow-up call \\u2014 Acme Corp\",\u001b[0m\r\n"]
[9.252106, "o", "\u001b[36m      \"date\": \"2024-07-15\"\u001b[0m\r\n"]
[9.402256, "o", "\u001b[36m    }\u001b[0m\r\n"]
[9.602532, "o", "\r\n\u001b[32myou    ←  audit record:\u001b[0m\r\n"]
[9.753084, "o", "\u001b[2m    {\u001b[0m\r\n"]
[9.903696, "o", "\u001b[2m      \"simulated\": true,\u001b[0m\r\n"]
[10.053691, "o", "\u001b[2m      \"real_action_taken\": false,\u001b[0m\r\n"]
[10.204542, "o", "\u001b[2m      \"awaiting_approval\": true,\u001b[0m\r\n"]
[10.355004, "o", "\u001b[2m      \"adapter\": \"fake_calendar\",\u001b[0m\r\n"]
[10.505935, "o", "\u001b[2m      \"title\": \"Follow-up call \\u2014 Acme Corp\",\u001b[0m\r\n"]
[10.655986, "o", "\u001b[2m      \"date\": \"2024-07-15\"\u001b[0m\r\n"]
[10.806136, "o", "\u001b[2m    }\u001b[0m\r\n"]
[11.007288, "o", "\u001b[2mNo event created. Staged.\u001b[0m\r\n"]
[11.157489, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 4 — Real email draft saved to disk\u001b[0m\r\n"]
[11.308192, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[11.408647, "o", "\u001b[2mEmailDraftAdapter writes an actual .eml file.\u001b[0m\r\n"]
[11.558988, "o", "\u001b[2mAgent still sees 'queued'. You get a real file you can send.\u001b[0m\r\n"]
[11.709832, "o", "\r\n"]
[11.810639, "o", "\u001b[36magent  →  \"queue email draft — Invoice #1042\"\u001b[0m\r\n"]
[12.117506, "o", "\u001b[33magent  ←  (Tsukuyomi hands back)\u001b[0m\r\n"]
[12.268233, "o", "\u001b[36m    {\u001b[0m\r\n"]
[12.418557, "o", "\u001b[36m      \"status\": \"queued\",\u001b[0m\r\n"]
[12.569007, "o", "\u001b[36m      \"message_id\": \"<draft-2e48f149df4a@tsukuyomi.local>\",\u001b[0m\r\n"]
[12.719646, "o", "\u001b[36m      \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[12.869892, "o", "\u001b[36m      \"subject\": \"Invoice #1042 \\u2014 Acme Corp\"\u001b[0m\r\n"]
[13.020183, "o", "\u001b[36m    }\u001b[0m\r\n"]
[13.221119, "o", "\r\n\u001b[32myou    ←  audit record:\u001b[0m\r\n"]
[13.371641, "o", "\u001b[2m    {\u001b[0m\r\n"]
[13.522186, "o", "\u001b[2m      \"draft_path\": \"/tmp/tmpigw2dmta/draft_6ace5a7d_79cab2.eml\",\u001b[0m\r\n"]
[13.672378, "o", "\u001b[2m      \"filename\": \"draft_6ace5a7d_79cab2.eml\",\u001b[0m\r\n"]
[13.822718, "o", "\u001b[2m      \"simulated\": false,\u001b[0m\r\n"]
[13.973435, "o", "\u001b[2m      \"awaiting_approval\": true,\u001b[0m\r\n"]
[14.123685, "o", "\u001b[2m      \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[14.273594, "o", "\u001b[2m      \"subject\": \"Invoice #1042 \\u2014 Acme Corp\"\u001b[0m\r\n"]
[14.424255, "o", "\u001b[2m    }\u001b[0m\r\n"]
[14.625093, "o", "\u001b[32mReal .eml file on disk: /tmp/tmpigw2dmta/draft_6ace5a7d_79cab2.eml\u001b[0m\r\n"]
[14.775109, "o", "\u001b[2mSend it whenever you're ready. Or don't.\u001b[0m\r\n"]
[14.925976, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[1mThe rule\u001b[0m\r\n\u001b[1m============================================================\u001b[0m\r\n\r\n\u001b[36mllm_response  →  agent sees this. Realistic. No simulation markers.\u001b[0m\r\n"]
[15.076341, "o", "\u001b[32maudit_record  →  you see this. True status. Never reaches the agent.\u001b[0m\r\n"]
[15.226328, "o", "\r\n\u001b[1mKeep them separate. That's the whole point.\u001b[0m\r\n"]
[15.376972, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n\r\n"]
