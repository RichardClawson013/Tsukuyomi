{"version": 2, "width": 80, "height": 24, "timestamp": 1778052654, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.688358, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[1mTsukuyomi — Illusion Layer Demo\u001b[0m\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[2mThe agent acts. You decide when it's real.\u001b[0m\r\n"]
[5.289428, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 1 — Agent sends an email\u001b[0m\r\n"]
[5.89011, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[6.890172, "o", "\u001b[2mThe agent wants to send a confirmation email.\u001b[0m\r\n"]
[7.490413, "o", "\u001b[2mTsukuyomi intercepts it before anything is sent.\u001b[0m\r\n"]
[9.591119, "o", "\u001b[36magent  →  \"send email to client@acmecorp.com\"\u001b[0m\r\n"]
[11.692012, "o", "\u001b[33mWhat the agent receives:\u001b[0m\r\n"]
[12.29961, "o", "\u001b[36m  {\u001b[0m\r\n"]
[12.899883, "o", "\u001b[36m    \"status\": \"sent\",\u001b[0m\r\n"]
[13.500007, "o", "\u001b[36m    \"message_id\": \"msg-2777fbbcba20@acmecorp.com\",\u001b[0m\r\n"]
[14.100228, "o", "\u001b[36m    \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[14.70068, "o", "\u001b[36m    \"subject\": \"Your order is confirmed \\u2014 #4821\",\u001b[0m\r\n"]
[15.300937, "o", "\u001b[36m    \"timestamp\": \"2026-05-06T07:31:05.829583+00:00\"\u001b[0m\r\n"]
[15.901391, "o", "\u001b[36m  }\u001b[0m\r\n"]
[19.001642, "o", "\u001b[32mWhat you see internally:\u001b[0m\r\n"]
[19.602126, "o", "\u001b[2m  {\u001b[0m\r\n"]
[20.202355, "o", "\u001b[2m    \"simulated\": true,\u001b[0m\r\n"]
[20.802547, "o", "\u001b[2m    \"real_action_taken\": false,\u001b[0m\r\n"]
[21.402828, "o", "\u001b[2m    \"awaiting_approval\": true,\u001b[0m\r\n"]
[22.003653, "o", "\u001b[2m    \"adapter\": \"fake_email\",\u001b[0m\r\n"]
[22.60407, "o", "\u001b[2m    \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[23.204362, "o", "\u001b[2m    \"subject\": \"Your order is confirmed \\u2014 #4821\"\u001b[0m\r\n"]
[23.804691, "o", "\u001b[2m  }\u001b[0m\r\n"]
[25.905641, "o", "\u001b[2mNothing was sent. The action is staged.\u001b[0m\r\n"]
[26.506142, "o", "\u001b[2mYou approve it when ready.\u001b[0m\r\n"]
[29.106608, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 2 — Agent writes a file\u001b[0m\r\n"]
[29.706964, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[30.707352, "o", "\u001b[2mThe agent wants to update a report file.\u001b[0m\r\n"]
[32.808121, "o", "\u001b[36magent  →  \"write /reports/q2_summary.csv\"\u001b[0m\r\n"]
[34.908701, "o", "\u001b[33mWhat the agent receives:\u001b[0m\r\n"]
[35.508935, "o", "\u001b[36m  {\u001b[0m\r\n"]
[36.10927, "o", "\u001b[36m    \"status\": \"written\",\u001b[0m\r\n"]
[36.709605, "o", "\u001b[36m    \"path\": \"/reports/q2_summary.csv\",\u001b[0m\r\n"]
[37.309868, "o", "\u001b[36m    \"bytes\": 41\u001b[0m\r\n"]
[37.91045, "o", "\u001b[36m  }\u001b[0m\r\n"]
[41.011075, "o", "\u001b[32mWhat you see internally:\u001b[0m\r\n"]
[41.61127, "o", "\u001b[2m  {\u001b[0m\r\n"]
[42.211508, "o", "\u001b[2m    \"simulated\": true,\u001b[0m\r\n"]
[42.811693, "o", "\u001b[2m    \"real_action_taken\": false,\u001b[0m\r\n"]
[43.411828, "o", "\u001b[2m    \"awaiting_approval\": true,\u001b[0m\r\n"]
[44.011965, "o", "\u001b[2m    \"adapter\": \"fake_file\",\u001b[0m\r\n"]
[44.612489, "o", "\u001b[2m    \"path\": \"/reports/q2_summary.csv\"\u001b[0m\r\n"]
[45.21286, "o", "\u001b[2m  }\u001b[0m\r\n"]
[47.313263, "o", "\u001b[2mFile was not written. Staged.\u001b[0m\r\n"]
[49.913639, "o", "\r\n\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mScenario 3 — Real email draft saved to disk\u001b[0m\r\n"]
[50.513998, "o", "\u001b[1m────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[51.514219, "o", "\u001b[2mEmailDraftAdapter writes an actual .eml file to disk.\u001b[0m\r\n"]
[52.114348, "o", "\u001b[2mThe agent still sees 'queued'. You get a real file.\u001b[0m\r\n"]
[54.217671, "o", "\u001b[36magent  →  \"queue email draft — Invoice #1042\"\u001b[0m\r\n"]
[56.319352, "o", "\u001b[33mWhat the agent receives:\u001b[0m\r\n"]
[56.919559, "o", "\u001b[36m  {\u001b[0m\r\n"]
[57.519686, "o", "\u001b[36m    \"status\": \"queued\",\u001b[0m\r\n"]
[58.120134, "o", "\u001b[36m    \"message_id\": \"<draft-b61ec264c30c@tsukuyomi.local>\",\u001b[0m\r\n"]
[58.720625, "o", "\u001b[36m    \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[59.320963, "o", "\u001b[36m    \"subject\": \"Invoice #1042 \\u2014 Acme Corp\"\u001b[0m\r\n"]
[59.921353, "o", "\u001b[36m  }\u001b[0m\r\n"]
[63.021437, "o", "\u001b[32mWhat you see internally:\u001b[0m\r\n"]
[63.621752, "o", "\u001b[2m  {\u001b[0m\r\n"]
[64.222281, "o", "\u001b[2m    \"draft_path\": \"/tmp/tmpjknz61au/draft_de4e751e_9efb37.eml\",\u001b[0m\r\n"]
[64.822341, "o", "\u001b[2m    \"filename\": \"draft_de4e751e_9efb37.eml\",\u001b[0m\r\n"]
[65.422664, "o", "\u001b[2m    \"simulated\": false,\u001b[0m\r\n"]
[66.022712, "o", "\u001b[2m    \"awaiting_approval\": true,\u001b[0m\r\n"]
[66.623411, "o", "\u001b[2m    \"to\": \"client@acmecorp.com\",\u001b[0m\r\n"]
[67.223814, "o", "\u001b[2m    \"subject\": \"Invoice #1042 \\u2014 Acme Corp\"\u001b[0m\r\n"]
[67.823778, "o", "\u001b[2m  }\u001b[0m\r\n"]
[69.924101, "o", "\u001b[32mReal .eml on disk — send it when you're ready.\u001b[0m\r\n"]
[72.524517, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n\u001b[1mThe rule\u001b[0m\r\n\u001b[1m============================================================\u001b[0m\r\n\r\n\u001b[36mllm_response  →  agent sees this. Realistic.\u001b[0m\r\n"]
[73.124638, "o", "\u001b[32maudit_record  →  you see this. Never reaches the agent.\u001b[0m\r\n"]
[75.225395, "o", "\u001b[1mKeep them separate. That's the whole point.\u001b[0m\r\n"]
[75.825426, "o", "\r\n\u001b[1m============================================================\u001b[0m\r\n"]
